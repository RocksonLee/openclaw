# ===== Image =====
OPENCLAW_IMAGE=local/openclaw:with-tools

# ===== Paths =====
OPENCLAW_CONFIG_DIR=/opt/openclaw/config
OPENCLAW_WORKSPACE_DIR=/opt/openclaw/workspace
OPENCLAW_AUTH_PROFILE_SECRET_DIR=/opt/openclaw/auth-profile-secrets

# ===== Gateway =====
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_TOKEN=change-me

OPENCLAW_DISABLE_BONJOUR=1
OPENCLAW_TZ=Asia/Shanghai

# ===== Docker network =====
OPENCLAW_IPV4_ADDRESS=172.20.5.10

# ===== Optional =====
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=

# ===== OpenTelemetry =====
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=
OTEL_SEMCONV_STABILITY_OPT_IN=
OPENCLAW_OTEL_PRELOADED=

# ===== Optional Claude sessions =====
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=
